{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notespace",
  "version": "0.1.0",
  "identifier": "com.howlil.notespace",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notespace",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "dataDirectory": "webview-data",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/fox-spirit/icon.ico", "icons/fox-spirit/icon.icns", "icons/fox-spirit/icon.png"],
    "externalBin": [
      "binaries/notespace-server"
    ],
    "resources": {
      "../../web/dist/client/": "web/"
    }
  }
}
