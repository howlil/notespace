---
import Brand from "./Brand.astro";
import ProductPreview from "./ProductPreview.astro";

const repo = "https://github.com/howlil/notespace";
---

<div class="hlh-root" id="top">
  <header class="hlh-header">
    <div class="hlh-shell hlh-nav">
      <Brand />
      <nav aria-label="Product navigation" class="hlh-links">
        <a href="/#product">Product</a>
        <a href="/#workflow">How it works</a>
        <a href="/#self-host">Documentation</a>
      </nav>
      <a class="hlh-github" href={repo} target="_blank" rel="noopener noreferrer">
        GitHub
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    </div>
  </header>

  <main class="hlh-main">
    <div class="hlh-shell">
      <div class="hlh-intro">
        <p class="hlh-meta">NOTESPACE / SELF-HOSTED KNOWLEDGE WORKSPACE</p>
        <h1>Write notes beside your canvas.</h1>
        <p class="hlh-summary">Organize notes and sketch relationships in the same workspace. Switch between writing and canvas without losing your place.</p>
        <div class="hlh-actions">
          <a class="hlh-primary" href="/#self-host">
            Self-host with Docker
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
          <a class="hlh-source" href={repo} target="_blank" rel="noopener noreferrer">
            View source
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
      </div>
      <figure class="hlh-proof">
        <figcaption class="hlh-proof-caption">
          <div>
            <span class="hlh-meta">WORKSPACE / DISTRIBUTED SYSTEMS</span>
            <strong>One workspace, two ways to think.</strong>
          </div>
          <span class="hlh-proof-state">SPLIT VIEW</span>
        </figcaption>
        <div class="hlh-product">
          <ProductPreview svgIdPrefix="hero-howlil" />
        </div>
      </figure>
    </div>
  </main>
</div>
