---
import BaseLayout from '../layouts/BaseLayout.astro'
import Brand from '../components/Brand.astro'
import ProductPreview from '../components/ProductPreview.astro'
import '../styles/white-hero.css'

const repoUrl = 'https://github.com/howlil/notespace'
const description = 'Notespace is a free, self-hosted knowledge workspace for structured notes and spatial thinking.'
---

<BaseLayout title="Notespace — Notes and canvas, one self-hosted workspace" description={description}>
  <div id="top" class="ns-white-landing min-h-screen overflow-x-hidden">
    <header class="ns-white-header">
      <div class="ns-white-header-inner">
        <Brand />
        <nav aria-label="Primary navigation">
          <a href="#product">Product</a>
          <a href="#self-host">Self-host</a>
          <a href={`${repoUrl}#self-host-with-docker`} target="_blank" rel="noopener noreferrer">Documentation</a>
        </nav>
        <a class="ns-white-github" href={repoUrl} target="_blank" rel="noopener noreferrer">
          GitHub
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </a>
      </div>
    </header>

    <main>
      <section id="main-content" class="ns-white-hero" aria-labelledby="hero-title">
        <div class="ns-white-hero-inner">
          <div class="ns-white-hero-copy">
            <p class="ns-white-kicker">Open source · Self-hosted knowledge workspace</p>
            <h1 id="hero-title">Your notes and <span>canvas</span>, in one place.</h1>
            <p class="ns-white-summary">
              Write structured notes, sketch systems, and return to the same context—all inside a workspace you control.
            </p>
            <div class="ns-white-actions">
              <a class="ns-white-primary" href="#self-host">
                Self-host with Docker
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                </svg>
              </a>
              <a class="ns-white-secondary" href={repoUrl} target="_blank" rel="noopener noreferrer">
                Explore on GitHub
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                </svg>
              </a>
            </div>
            <ul class="ns-white-facts" aria-label="Notespace properties">
              <li>Free & open source</li>
              <li>SQLite storage</li>
              <li>No hosted account</li>
            </ul>
          </div>
          <div class="ns-white-showcase">
            <div class="ns-white-showcase-caption">
              <div>
                <p class="ns-white-preview-label">PRODUCT PREVIEW</p>
                <h2>Work with notes and canvas side by side.</h2>
              </div>
              <p class="ns-white-preview-hint">Switch views or search the example workspace</p>
            </div>
            <ProductPreview interactive svgIdPrefix="landing-white-hero" />
            <p class="ns-white-demo-note">Interactive product illustration · example content, no backend connection</p>
          </div>
        </div>
      </section>

      <section id="product" class="border-b border-line bg-surface" aria-labelledby="product-title">
        <div class="mx-auto max-w-[1180px] px-5 py-16 sm:px-7 lg:px-8 lg:py-20">
          <div class="grid gap-10 lg:grid-cols-[0.68fr_1.32fr] lg:gap-20">
            <div>
              <p class="text-[10px] font-medium uppercase tracking-[0.14em] text-accent">The product model</p>
              <h2 id="product-title" class="mt-3 max-w-[370px] text-[28px] font-semibold leading-[1.12] tracking-[-0.04em]">A knowledge workspace, not another dashboard.</h2>
              <p class="mt-4 max-w-[390px] text-[13px] leading-6 text-muted">The library stays simple. Categories organize workspaces. Each workspace owns its notes and canvas. No separate graph, database, or file-explorer hierarchy to manage.</p>
            </div>

            <div class="divide-y divide-line border-y border-line">
              <div class="grid gap-3 py-6 sm:grid-cols-[140px_1fr] sm:gap-8">
                <span class="font-mono text-[10px] text-muted">CATEGORY</span>
                <div><h3 class="text-[13px] font-semibold">Group knowledge without turning Home into a tree view.</h3><p class="mt-1.5 text-[12px] leading-5 text-muted">Browse progressively, then open a category when you need search, filtering, sorting, and the full workspace list.</p></div>
              </div>
              <div class="grid gap-3 py-6 sm:grid-cols-[140px_1fr] sm:gap-8">
                <span class="font-mono text-[10px] text-muted">WORKSPACE</span>
                <div><h3 class="text-[13px] font-semibold">Keep writing and spatial thinking in one durable context.</h3><p class="mt-1.5 text-[12px] leading-5 text-muted">A workspace can hold multiple notes plus one canvas, with split layouts when you need to see them together.</p></div>
              </div>
              <div class="grid gap-3 py-6 sm:grid-cols-[140px_1fr] sm:gap-8">
                <span class="font-mono text-[10px] text-muted">NOTE / CANVAS</span>
                <div><h3 class="text-[13px] font-semibold">Use the right surface without creating another top-level object.</h3><p class="mt-1.5 text-[12px] leading-5 text-muted">Write structured notes with Tiptap. Sketch systems and relationships with Excalidraw. Both remain owned by the workspace.</p></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="workflow" class="border-b border-line" aria-labelledby="workflow-title">
        <div class="mx-auto max-w-[1180px] px-5 py-16 sm:px-7 lg:px-8 lg:py-20">
          <div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-[10px] font-medium uppercase tracking-[0.14em] text-accent">Core workflow</p>
              <h2 id="workflow-title" class="mt-3 text-[28px] font-semibold tracking-[-0.04em]">Capture → work → find → resume.</h2>
            </div>
            <p class="max-w-[420px] text-[12px] leading-5 text-muted">The landing page mirrors the real product loop instead of selling a pile of disconnected features.</p>
          </div>

          <div class="grid border border-line bg-surface sm:grid-cols-2 lg:grid-cols-4">
            <article class="min-h-[190px] border-b border-line p-5 sm:border-r lg:border-b-0">
              <span class="font-mono text-[10px] text-muted">01 / CAPTURE</span>
              <h3 class="mt-8 text-[14px] font-semibold">Save an idea where it belongs.</h3>
              <p class="mt-2 text-[11px] leading-5 text-muted">Quick Capture creates a durable note inside an existing workspace, including Markdown import.</p>
            </article>
            <article class="min-h-[190px] border-b border-line p-5 lg:border-b-0 lg:border-r">
              <span class="font-mono text-[10px] text-muted">02 / WORK</span>
              <h3 class="mt-8 text-[14px] font-semibold">Write and sketch side by side.</h3>
              <p class="mt-2 text-[11px] leading-5 text-muted">Use Note, Canvas, or bounded split panes without leaving the workspace context.</p>
            </article>
            <article class="min-h-[190px] border-b border-line p-5 sm:border-r sm:border-b-0 lg:border-r">
              <span class="font-mono text-[10px] text-muted">03 / FIND</span>
              <h3 class="mt-8 text-[14px] font-semibold">Return to the exact context.</h3>
              <p class="mt-2 text-[11px] leading-5 text-muted">Global search resolves categories, workspaces, notes, and exact blocks instead of only matching titles.</p>
            </article>
            <article class="min-h-[190px] p-5">
              <span class="font-mono text-[10px] text-muted">04 / RECOVER</span>
              <h3 class="mt-8 text-[14px] font-semibold">Own a path back.</h3>
              <p class="mt-2 text-[11px] leading-5 text-muted">Workspace history and full-library backup keep recovery explicit without duplicating your source of truth.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="border-b border-line bg-surface">
        <div class="mx-auto grid max-w-[1180px] gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
          <div class="bg-surface px-5 py-8 sm:px-7 lg:px-8"><p class="text-[20px] font-semibold tracking-[-0.04em]">Up to 4</p><p class="mt-1 text-[11px] text-muted">bounded workspace panes</p></div>
          <div class="bg-surface px-5 py-8 sm:px-7 lg:px-8"><p class="text-[20px] font-semibold tracking-[-0.04em]">SQLite</p><p class="mt-1 text-[11px] text-muted">durable authored state</p></div>
          <div class="bg-surface px-5 py-8 sm:px-7 lg:px-8"><p class="text-[20px] font-semibold tracking-[-0.04em]">1 container</p><p class="mt-1 text-[11px] text-muted">self-hosted runtime</p></div>
          <div class="bg-surface px-5 py-8 sm:px-7 lg:px-8"><p class="text-[20px] font-semibold tracking-[-0.04em]">No cloud</p><p class="mt-1 text-[11px] text-muted">required for core editing</p></div>
        </div>
      </section>

      <section id="self-host" class="border-b border-line">
        <div class="mx-auto grid max-w-[1180px] gap-10 px-5 py-16 sm:px-7 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-20 lg:px-8 lg:py-20">
          <div>
            <p class="text-[10px] font-medium uppercase tracking-[0.14em] text-accent">Self-hosting</p>
            <h2 class="mt-3 text-[28px] font-semibold tracking-[-0.04em]">Run the whole workspace yourself.</h2>
            <p class="mt-4 max-w-[440px] text-[13px] leading-6 text-muted">Notespace ships as one Go application serving the web UI and API, with SQLite for durable state. Docker Compose is the default deployment path.</p>
            <a class="mt-6 inline-flex items-center gap-1.5 text-[12px] font-medium text-accent hover:underline" href={`${repoUrl}#self-host-with-docker`} target="_blank" rel="noreferrer">Read the self-hosting guide <span aria-hidden="true">↗</span></a>
          </div>

          <div class="overflow-hidden rounded-xl border border-line bg-[#16171b] text-[#e8e8ef] shadow-[0_18px_50px_rgba(0,0,0,0.12)]">
            <div class="flex h-10 items-center border-b border-[#303138] px-4 text-[10px] text-[#8f929f]"><span>terminal</span><span class="ml-auto">docker compose</span></div>
            <pre class="overflow-x-auto p-5 text-[11px] leading-6"><code><span class="text-[#7fa6c9]">$</span> git clone https://github.com/howlil/notespace.git
<span class="text-[#7fa6c9]">$</span> cd notespace
<span class="text-[#7fa6c9]">$</span> docker compose -f compose.yaml -f compose.local.yaml up --build -d --wait

<span class="text-[#6f947d]">✓</span> Notespace is ready on localhost:8080</code></pre>
          </div>
        </div>
      </section>

      <section>
        <div class="mx-auto flex max-w-[1180px] flex-col gap-6 px-5 py-14 sm:flex-row sm:items-center sm:justify-between sm:px-7 lg:px-8">
          <div>
            <p class="text-[20px] font-semibold tracking-[-0.035em]">A smaller surface for deeper work.</p>
            <p class="mt-1 text-[12px] text-muted">No hosted account required for the core workspace.</p>
          </div>
          <a class="inline-flex h-10 w-fit items-center gap-2 rounded-md bg-ink px-4 text-[12px] font-medium text-background transition-opacity hover:opacity-90" href={repoUrl} target="_blank" rel="noreferrer">Explore Notespace on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="border-t border-line bg-surface">
      <div class="mx-auto flex max-w-[1180px] flex-col gap-3 px-5 py-7 text-[10px] text-muted sm:flex-row sm:items-center sm:justify-between sm:px-7 lg:px-8">
        <span>Notespace — free, self-hosted knowledge workspace.</span>
        <span>Built for notes, canvas, and durable ownership.</span>
      </div>
    </footer>
  </div>
</BaseLayout>
