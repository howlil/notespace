{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Bundled Notespace startup and recovery UI only; no remote origins.",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    },
    "allow-desktop-retry-runtime",
    "allow-list-desktop-recovery-points",
    "allow-desktop-recovery-diagnostics",
    "allow-list-desktop-manual-backups",
    "allow-create-desktop-manual-backup"
  ]
}
