---
import BaseLayout from '../layouts/BaseLayout.astro'
import '@fontsource/geist/400.css'
import '@fontsource/geist/500.css'
import '@fontsource/geist/600.css'
import '../styles/showcase.css'

const repoUrl = 'https://github.com/howlil/notespace'
const releasesUrl = `${repoUrl}/releases`
const docsUrl = `${repoUrl}#self-host-with-docker`
const windowsVersion = '1.0.3'
// Known-good fallback. The client script swaps in the newest published MSI when GitHub answers.
const windowsMsiUrl = `${repoUrl}/releases/download/v${windowsVersion}/Notespace_${windowsVersion}_x64_en-US.msi`
const description = 'Diagrams, runnable code, and a searchable library in one workspace. Install the Windows app or run your own server with Docker.'

// Every shipped feature, grouped the way the app groups them. Labels match the app's own text.
const groups = [
  ['Canvas', [
    ['Tools', 'Select, hand, shapes, arrows, lines, pen, text, image, and eraser, plus code, note, and diagram tools.'],
    ['Canvas options', 'Object snapping, a Selection toolbar (Floating, Compact, Docked, or Off), background pattern, and colors.'],
    ['Navigation', 'Undo, Redo, zoom, and Fit canvas.'],
    ['Multi-tab sync', 'Other open tabs of the same workspace in this browser stay in sync.'],
  ]],
  ['Code blocks', [
    ['Run JavaScript', 'Runs in a worker. Show code output reveals the result under the block.'],
    ['Preview HTML', 'Renders in a sandboxed frame.'],
    ['Layout', 'Code language, Code theme, Line numbers, and Fit to content.'],
    ['Block actions', 'Copy code, Duplicate code block, and Delete code block.'],
  ]],
  ['Diagrams', [
    ['Component palette', 'General Components and more, with search across more than 2,200 components.'],
    ['Drag to insert', 'Drag a component onto the canvas.'],
    ['Connect', 'Select two nodes, then connect them.'],
  ]],
  ['Canvas notes', [
    ['Note tool', 'Press N to add a note.'],
    ['Place existing Note', 'Put one note in several workspaces.'],
    ['Info & backlinks', 'Lists the workspaces a note is in, and its backlinks.'],
    ['Markdown', 'Headings, task lists, tables, and LaTeX math.'],
    ['Remove', 'Move to Trash, or Remove instance.'],
  ]],
  ['Library and search', [
    ['Categories', 'The Explorer groups workspaces by category.'],
    ['Workspace grid', 'Paged cards, with Previous and Next.'],
    ['Quick Open', 'Ctrl/⌘ K, then type to find a workspace.'],
    ['Trash', 'Restore a Workspace or Note, or use Delete permanently.'],
  ]],
  ['Saving and recovery', [
    ['Save status', 'Saved appears only after SQLite confirms the write.'],
    ['Conflict recovery', 'Retry merged save, Download draft, Use saved Canvas, or Keep editing.'],
    ['Export ZIP', 'Includes Workspaces, Canvas content, images, Notes, and Trash.'],
    ['Restore backup', 'Restoring a backup replaces your current library.'],
    ['Device recovery', 'Device recovery snapshots are available in the Windows desktop app.'],
  ]],
  ['Settings', [
    ['Theme', 'System, Light, or Dark.'],
    ['Color theme', 'Paper, Stone, Sage, Amber, or Graphite.'],
    ['Library storage', 'Shows "Saved in this browser" on the web and "Saved on this device" in the desktop app.'],
  ]],
]
---

<BaseLayout title="Notespace — Write, draw, and run code on one canvas" description={description}>
  <div id="top" class="nx">
    <header class="nx-nav">
      <div class="nx-wrap nx-nav-row">
        <a class="nx-brand" href="#top" aria-label="Notespace home">
          <img src="/brand/notespace-fox-head.svg" width="24" height="24" alt="" />
          <span>Notespace</span>
        </a>
        <nav class="nx-links" aria-label="Primary">
          <a href="#features">Features</a>
          <a href="#windows">Windows</a>
          <a href="#self-host">Self-host</a>
        </nav>
        <div class="nx-nav-end">
          <a class="nx-btn nx-btn-primary nx-btn-sm nx-nav-cta" href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
          <button class="nx-menu" type="button" aria-controls="nx-mobile" aria-expanded="false">Menu</button>
        </div>
      </div>
      <nav class="nx-mobile" id="nx-mobile" aria-label="Mobile" hidden>
        <a href="#features">Features</a>
        <a href="#windows">Windows</a>
        <a href="#self-host">Self-host</a>
        <a href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="nx-hero" aria-labelledby="hero-title">
        <div class="nx-wrap">
          <h1 id="hero-title">Write, draw, and run code on one canvas.</h1>
          <p class="nx-lead">Diagrams, runnable code, and a searchable library in one workspace. Install the Windows app, or run your own server.</p>
          <div class="nx-cta">
            <a class="nx-btn nx-btn-primary" href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
            <a class="nx-btn nx-btn-ghost" href="#self-host">Self-host with Docker</a>
          </div>
          <p class="nx-fine">Windows 64-bit · <span data-notespace-windows-version>v{windowsVersion}</span> · Unsigned installer</p>
          <figure class="nx-shot">
            <img src="/product/canvas.webp" width="2160" height="1350" alt="Canvas with four boxes, Web app, API server, Worker and SQLite, joined by labeled arrows, and two code blocks below." fetchpriority="high" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="code" class="nx-section" aria-labelledby="code-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">01</p>
            <h2 id="code-title" class="nx-h2">Run JavaScript. Preview HTML.</h2>
            <p>JavaScript runs in a worker. HTML renders in a sandboxed frame.</p>
          </header>
          <figure class="nx-shot">
            <img src="/product/code.webp" width="2160" height="1350" alt="JavaScript code block with output Browser → Server, beside an HTML block previewed as a Release checklist." loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="diagrams" class="nx-section" aria-labelledby="diagrams-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">02</p>
            <h2 id="diagrams-title" class="nx-h2">Drop components onto the canvas.</h2>
            <p>Search more than 2,200 components, then connect two selected nodes.</p>
          </header>
          <figure class="nx-shot">
            <img src="/product/diagram.webp" width="2160" height="1350" alt="Diagram palette on General Components, with User, Server and Database placed on the canvas." loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="notes" class="nx-section" aria-labelledby="notes-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">03</p>
            <h2 id="notes-title" class="nx-h2">Canvas notes you can place anywhere.</h2>
            <p>Place the same note in several workspaces. Info &amp; backlinks lists where it lives.</p>
          </header>
          <div class="nx-pair">
            <figure class="nx-shot">
              <img src="/product/note.webp" width="2160" height="1350" alt="Canvas note titled Launch checklist, its heading in bold above two lines of text." loading="lazy" decoding="async" />
            </figure>
            <figure class="nx-shot">
              <img src="/product/note-placements.webp" width="2160" height="1350" alt="Note info for Launch checklist: placed in Roadmap Q4 and Launch plan, with no backlinks yet." loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </section>

      <section id="saving" class="nx-section" aria-labelledby="saving-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">04</p>
            <h2 id="saving-title" class="nx-h2">Conflicts pause autosave and open a dialog.</h2>
            <p>Four choices. Use saved Canvas asks before it removes your unsaved changes.</p>
          </header>
          <figure class="nx-shot">
            <img src="/product/conflict.webp" width="2160" height="1350" alt="Recover Canvas changes dialog: Your Canvas changed elsewhere, with Retry merged save, Download draft, Use saved Canvas and Keep editing." loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="library" class="nx-section" aria-labelledby="library-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">05</p>
            <h2 id="library-title" class="nx-h2">Every workspace, one shortcut away.</h2>
            <p>Categories sit in the Explorer. Ctrl/⌘ K opens Quick Open.</p>
          </header>
          <div class="nx-pair">
            <figure class="nx-shot">
              <img src="/product/library.webp" width="2160" height="1350" alt="Your workspaces as a card grid beside the Categories explorer." loading="lazy" decoding="async" />
            </figure>
            <figure class="nx-shot">
              <img src="/product/quick-open.webp" width="2160" height="1350" alt="Quick Open with API typed in, returning API architecture under Engineering." loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </section>

      <section id="backup" class="nx-section" aria-labelledby="backup-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">06</p>
            <h2 id="backup-title" class="nx-h2">Back up the library. Restore it. Recover deleted work.</h2>
            <p>Export ZIP includes Workspaces, Canvas content, images, Notes, and Trash. Restore asks before replacing your library.</p>
          </header>
          <figure class="nx-shot">
            <img src="/product/data-trash.webp" width="2160" height="1350" alt="Settings, Data and backup: Export ZIP, Restore backup, and a Trash list holding a deleted workspace." loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="themes" class="nx-section" aria-labelledby="themes-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">07</p>
            <h2 id="themes-title" class="nx-h2">Light, dark, or system. Five color themes.</h2>
            <p>Paper, Stone, Sage, Amber, and Graphite.</p>
          </header>
          <figure class="nx-shot">
            <img src="/product/appearance-dark.webp" width="2160" height="1350" alt="Settings, General in dark mode, with the Paper color theme selected." loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>

      <section id="features" class="nx-section" aria-labelledby="features-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <h2 id="features-title" class="nx-h2">Every feature, in one list.</h2>
          </header>
          <div class="nx-index">
            {groups.map(([title, items]) => (
              <div class="nx-group">
                <h3>{title}</h3>
                <dl>
                  {items.map(([term, detail]) => (
                    <div>
                      <dt>{term}</dt>
                      <dd>{detail}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="windows" class="nx-section" aria-labelledby="windows-title">
        <div class="nx-wrap nx-split">
          <div class="nx-split-copy">
            <p class="nx-num" aria-hidden="true">08</p>
            <h2 id="windows-title" class="nx-h2">Notespace for Windows.</h2>
            <p>A 64-bit MSI from GitHub Releases. It is unsigned, so Windows may show an “Unknown Publisher” warning.</p>
            <div class="nx-cta">
              <a class="nx-btn nx-btn-primary" href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
              <a class="nx-link" href={releasesUrl} target="_blank" rel="noopener noreferrer">All releases</a>
            </div>
          </div>
          <dl class="nx-facts">
            <div><dt>Version</dt><dd data-notespace-windows-version>v{windowsVersion}</dd></div>
            <div><dt>Installer</dt><dd>MSI, unsigned</dd></div>
            <div><dt>Library</dt><dd>Saved on this device</dd></div>
          </dl>
        </div>
      </section>

      <section id="self-host" class="nx-section" aria-labelledby="self-host-title">
        <div class="nx-wrap">
          <header class="nx-head">
            <p class="nx-num" aria-hidden="true">09</p>
            <h2 id="self-host-title" class="nx-h2">Run your own server with Docker.</h2>
            <p>Clone the repository and start it with Docker Compose. Set NOTESPACE_PASSWORD before you expose it.</p>
          </header>
          <pre class="nx-term"><code>git clone https://github.com/howlil/notespace.git
cd notespace
docker compose -f compose.yaml -f compose.local.yaml up --build -d --wait

# then open http://localhost:8080</code></pre>
          <ul class="nx-specs">
            <li><b>Data in one volume</b><span>Kept in the notespace-data volume.</span></li>
            <li><b>Optional password</b><span>NOTESPACE_PASSWORD turns on HTTP Basic, user notespace.</span></li>
            <li><b>Health check</b><span>/api/health stays open for platform checks.</span></li>
          </ul>
          <a class="nx-link nx-more" href={docsUrl} target="_blank" rel="noopener noreferrer">Read the self-host guide</a>
        </div>
      </section>

      <section class="nx-close" aria-labelledby="close-title">
        <div class="nx-wrap">
          <h2 id="close-title">Start with one canvas.</h2>
          <div class="nx-cta">
            <a class="nx-btn nx-btn-primary" href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
            <a class="nx-btn nx-btn-ghost" href={docsUrl} target="_blank" rel="noopener noreferrer">Self-host guide</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="nx-foot">
      <div class="nx-wrap nx-foot-row">
        <span class="nx-brand"><img src="/brand/notespace-fox-head.svg" width="24" height="24" alt="" /><span>Notespace</span></span>
        <nav class="nx-foot-links" aria-label="Footer">
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={releasesUrl} target="_blank" rel="noopener noreferrer">Releases</a>
          <a href={docsUrl} target="_blank" rel="noopener noreferrer">Self-host guide</a>
        </nav>
      </div>
    </footer>

    <script>
      import { latestWindowsInstaller } from '../lib/windows-release.mjs';

      // Progressive enhancement: every download link already points at the verified MSI.
      async function refreshWindowsDownload() {
        try {
          const response = await fetch(
            'https://api.github.com/repos/howlil/notespace/releases?per_page=30',
            { headers: { Accept: 'application/vnd.github+json' }, signal: AbortSignal.timeout(3500) },
          );
          if (!response.ok) return;
          const installer = latestWindowsInstaller(await response.json());
          if (!installer) return;
          document.querySelectorAll('a[data-notespace-windows-download]').forEach((link) => {
            link.setAttribute('href', installer.url);
          });
          document.querySelectorAll('[data-notespace-windows-version]').forEach((label) => {
            label.textContent = `v${installer.version}`;
          });
        } catch {
          // Keep the static known-good installer link.
        }
      }
      void refreshWindowsDownload();
    </script>
    <script is:inline>
      (() => {
        const menu = document.querySelector('.nx-menu');
        const panel = document.getElementById('nx-mobile');
        const setOpen = (open) => {
          panel.hidden = !open;
          menu.setAttribute('aria-expanded', String(open));
        };
        menu.addEventListener('click', () => setOpen(panel.hidden));
        panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      })();
    </script>
  </div>
</BaseLayout>
