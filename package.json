{
  "name": "notespace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @notespace/web dev",
    "build": "pnpm --filter @notespace/web build",
    "typecheck": "pnpm --filter @notespace/web typecheck",
    "lint": "eslint apps/web/src tests --max-warnings 0",
    "test": "node --experimental-strip-types --test apps/web/src/adapters/browser/local-storage.test.ts apps/web/src/domain/planning/planning.test.ts apps/web/src/domain/workspace/autosave.test.ts apps/web/src/adapters/http/client.test.ts apps/web/src/domain/workspace/canvas-merge.test.ts apps/web/src/features/workspace-authoring/model/granular-save.test.ts apps/web/src/domain/document/markdown.test.ts apps/web/src/features/workspace-authoring/document/editor-floating.test.ts apps/web/src/features/workspace-authoring/canvas/canvas-state.test.ts apps/web/src/features/workspace-authoring/canvas/canvas-scene-state.test.ts apps/web/src/features/workspace-authoring/canvas/canvas-selection-capabilities.test.ts apps/web/src/features/workspace-authoring/canvas/canvas-code-block.test.ts apps/web/src/features/workspace-authoring/canvas/canvas-code-block-layout.test.ts apps/web/src/features/workspace-authoring/canvas/canvas-code-runner.test.ts apps/web/src/features/capture/workspace-options.test.ts apps/web/src/domain/diagram/diagram.test.ts apps/web/src/domain/diagram/routing.test.ts apps/web/src/features/workspace-authoring/diagram/eraser-icons.test.ts apps/web/src/features/library/vault-import.test.ts apps/web/src/features/library/vault-import-workflow.test.ts apps/web/src/features/library/workspace-mutation-policy.test.ts apps/web/src/features/study/activity-recovery.test.ts apps/web/src/features/study/study-timer.test.ts apps/web/src/features/workspace-authoring/model/pane-layout.test.ts apps/web/src/features/workspace-authoring/model/workspace-session-state.test.ts apps/web/src/domain/workspace/canvas-frame-link.test.ts apps/web/src/features/workspace-authoring/model/workspace-content.test.ts tests/architecture-boundaries.test.ts tests/design-contract.test.ts tests/responsive-contract.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:critical": "playwright test tests/navigation.spec.ts tests/search.spec.ts tests/recovery.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.55.0"
  }
}
