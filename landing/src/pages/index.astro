---
import BaseLayout from '../layouts/BaseLayout.astro'
import '@fontsource/geist/400.css'
import '@fontsource/geist/500.css'
import '@fontsource/geist/600.css'
import '../styles/showcase.css'

const repoUrl = 'https://github.com/howlil/notespace'
const releasesUrl = `${repoUrl}/releases`
const docsUrl = `${repoUrl}#self-host-with-docker`
const windowsMsiUrl = `${repoUrl}/releases/download/v0.1.0-beta.1/Notespace_0.1.0-beta.1_x64_en-US.msi`
const description = 'A self-hosted canvas for diagrams, sketches, images and runnable code, saved to SQLite.'

// Inline Lucide-style strokes on a 24px grid, so the page adds no icon dependency.
const paths = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  chevDown: '<path d="m6 9 6 6 6-6"/>',
  chevRight: '<path d="m9 6 6 6-6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  play: '<path d="M7 4.5v15l12-7.5z"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>',
  more: '<circle cx="5" cy="12" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><circle cx="19" cy="12" r="1.3" fill="currentColor"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  pointer: '<path d="M5 3.5l6.2 16.2 2.6-6.6 6.6-2.6z"/>',
  rect: '<rect x="4" y="6" width="16" height="12" rx="2"/>',
  arrow: '<path d="M5 19 19 5"/><path d="M9 5h10v10"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5L5 20"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>',
  redo: '<path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/>',
  minus: '<path d="M5 12h14"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  fit: '<path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/>',
  stroke: '<circle cx="12" cy="12" r="6"/>',
  weight: '<path d="M4 12h16"/>',
  minimize: '<path d="M5 12h14"/>',
  maximize: '<rect x="5" y="5" width="14" height="14" rx="1"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  sliders: '<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
  database: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  archive: '<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/>',
  download: '<path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/>',
  upload: '<path d="M12 15V4"/><path d="m7 9 5-5 5 5"/><path d="M5 20h14"/>',
  restore: '<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>',
  trash: '<path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/><path d="M9 7V4h6v3"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
}
const svg = (inner) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${inner}</svg>`
const I = Object.fromEntries(Object.entries(paths).map(([key, inner]) => [key, svg(inner)]))

// Illustrative titles for the Library mock. Pages mirror the app's Previous / Next paging.
const libraryPages = [
  ['Checkout API', 'Event pipeline', 'Auth flow', 'Data model', 'Rollout plan', 'Incident log'],
  ['Search index', 'Cache layers', 'Billing flow', 'Mobile API', 'Onboarding', 'Metrics plan'],
  ['Queue retries', 'Pricing tiers', 'Payments', 'Email jobs', 'Admin tools', 'Audit log'],
  ['Sprint board', 'Roadmap', 'Load tests', 'Feature flags', 'Logs', 'Postmortems'],
]

// Three line-art diagram thumbnails, cycled across the library cards.
const thumbs = [
  '<svg viewBox="0 0 160 120" fill="none" focusable="false"><rect x="18" y="44" width="44" height="32" rx="6" fill="#ffffff" stroke="#7d8394" stroke-width="1.2"/><rect x="98" y="44" width="44" height="32" rx="6" fill="#ffffff" stroke="#7d8394" stroke-width="1.2"/><path d="M62 60H98" stroke="#4a5062" stroke-width="1.4" stroke-linecap="round"/></svg>',
  '<svg viewBox="0 0 160 120" fill="none" focusable="false"><path d="M80 20L106 46L80 72L54 46Z" fill="#ffffff" stroke="#2858d8" stroke-width="1.4"/><rect x="22" y="80" width="46" height="24" rx="6" fill="#ffffff" stroke="#7d8394" stroke-width="1.2"/><path d="M68 92H96" stroke="#4a5062" stroke-width="1.4" stroke-linecap="round"/></svg>',
  '<svg viewBox="0 0 160 120" fill="none" focusable="false"><circle cx="54" cy="58" r="24" fill="#eaf0ff" stroke="#7d8394" stroke-width="1.2"/><path d="M92 84C112 52 124 96 146 60" stroke="#252630" stroke-width="1.6" stroke-linecap="round"/></svg>',
]
---

<BaseLayout title="Notespace — Draw it. Run it. Own it." description={description}>
  <div id="top" class="nsx">
    <header class="nsx-nav">
      <div class="nsx-wrap nsx-nav-row">
        <a class="nsx-brand" href="#top" aria-label="Notespace home">
          <img src="/brand/notespace-fox-head.svg" width="26" height="26" alt="" aria-hidden="true" decoding="async" />
          <span>Notespace</span>
        </a>
        <nav class="nsx-nav-links" aria-label="Primary navigation">
          <a href="#canvas">Canvas</a>
          <a href="#library">Library</a>
          <a href="#saving">Saving</a>
          <a href="#desktop">Desktop</a>
          <a href="#self-host">Self-host</a>
        </nav>
        <div class="nsx-nav-actions">
          <a class="nsx-link-quiet" href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="nsx-btn nsx-btn-primary nsx-btn-sm" href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
          <button class="nsx-menu-toggle" type="button" aria-label="Menu" aria-controls="nsx-mobile-nav" aria-expanded="false">
            <span class="nsx-i" set:html={I.menu}></span>
          </button>
        </div>
      </div>
      <nav class="nsx-mobile-nav" id="nsx-mobile-nav" aria-label="Mobile navigation" data-open="false">
        <a href="#canvas">Canvas</a>
        <a href="#library">Library</a>
        <a href="#saving">Saving</a>
        <a href="#desktop">Desktop</a>
        <a href="#self-host">Self-host</a>
        <a href={windowsMsiUrl} data-notespace-windows-download>Download for Windows</a>
        <a href={docsUrl} target="_blank" rel="noopener noreferrer">Self-host guide</a>
        <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </header>

    <main id="main-content">
      <!-- HERO: the headline, the download, and the real app shell -->
      <section class="nsx-hero" aria-labelledby="hero-title">
        <div class="nsx-wrap">
          <h1 id="hero-title" class="nsx-h1"><span class="nsx-line">Draw it. Run it.</span> <span class="nsx-line">Own it.</span></h1>

          <div class="nsx-hero-meta">
            <p class="nsx-lead">A self-hosted canvas for diagrams, sketches, images and runnable code. Everything stays in one SQLite file you control.</p>
            <div class="nsx-hero-cta">
              <div class="nsx-cta-row">
                <a class="nsx-btn nsx-btn-primary" href={windowsMsiUrl} data-notespace-windows-download>
                  Download for Windows
                  <span class="nsx-i" set:html={I.arrowRight}></span>
                </a>
                <a class="nsx-btn nsx-btn-ghost" href="#self-host">Self-host with Docker</a>
              </div>
              <p class="nsx-fineprint">Beta · Windows 64-bit · <span data-notespace-windows-version>v0.1.0-beta.1</span> · Unsigned installer</p>
            </div>
          </div>

          <div class="nsx-app" role="img" aria-label="The Notespace app: Categories in the Explorer, a diagram of a Browser, Go server, Redis and PostgreSQL on the Canvas, a runnable JavaScript code block, and Quick Open searching for checkout.">
            <div class="nsx-titlebar" aria-hidden="true">
              <img class="nsx-tb-fox" src="/brand/notespace-fox-head.svg" width="16" height="16" alt="" decoding="async" />
              <span class="nsx-tb-name">Checkout API</span>
              <span class="nsx-tb-keys"><kbd class="nsx-kbd">Ctrl</kbd><kbd class="nsx-kbd">K</kbd></span>
            </div>
            <div class="nsx-app-body" aria-hidden="true">
              <aside class="nsx-explorer">
                <p class="nsx-group-label">Categories</p>
                <ul class="nsx-tree">
                  <li class="nsx-tree-row"><span class="nsx-i" set:html={I.chevDown}></span>Architecture</li>
                  <li class="nsx-tree-row nsx-tree-child is-active">Checkout API</li>
                  <li class="nsx-tree-row nsx-tree-child">Event pipeline</li>
                  <li class="nsx-tree-row nsx-tree-child">Auth flow</li>
                  <li class="nsx-tree-row"><span class="nsx-i" set:html={I.chevRight}></span>Research</li>
                  <li class="nsx-tree-row"><span class="nsx-i" set:html={I.chevRight}></span>Scratch</li>
                </ul>
              </aside>

              <div class="nsx-canvas">
                <div class="nsx-rail">
                  <span class="nsx-ibtn is-on"><span class="nsx-i" set:html={I.pointer}></span></span>
                  <span class="nsx-ibtn"><span class="nsx-i" set:html={I.rect}></span></span>
                  <span class="nsx-ibtn"><span class="nsx-i" set:html={I.arrow}></span></span>
                  <span class="nsx-ibtn"><span class="nsx-i" set:html={I.pen}></span></span>
                  <span class="nsx-ibtn"><span class="nsx-i" set:html={I.image}></span></span>
                </div>

                <div class="nsx-quick">
                  <div class="nsx-quick-input">
                    <span class="nsx-i" set:html={I.search}></span>
                    <span class="nsx-quick-text" data-quick-input data-placeholder="Open workspace or category…"></span>
                    <span class="nsx-caret"></span>
                  </div>
                  <div class="nsx-quick-group" data-results="">
                    <p class="nsx-quick-head">Recent workspaces</p>
                    <ul>
                      <li class="nsx-quick-row is-selected"><span>Checkout API</span><em>Architecture</em></li>
                      <li class="nsx-quick-row"><span>Event pipeline</span><em>Architecture</em></li>
                    </ul>
                  </div>
                  <div class="nsx-quick-group" data-results="checkout" hidden>
                    <p class="nsx-quick-head">Search results</p>
                    <ul>
                      <li class="nsx-quick-row is-selected"><span>Checkout API</span><em>Architecture</em></li>
                      <li class="nsx-quick-row"><span>Checkout retries</span><em>Research</em></li>
                    </ul>
                  </div>
                  <div class="nsx-quick-group" data-results="postgres" hidden>
                    <p class="nsx-quick-head">Search results</p>
                    <ul>
                      <li class="nsx-quick-row is-selected"><span>Postgres migration notes</span><em>Research</em></li>
                      <li class="nsx-quick-row"><span>Database replicas</span><em>Architecture</em></li>
                    </ul>
                  </div>
                  <div class="nsx-quick-group" data-results="redis" hidden>
                    <p class="nsx-quick-head">Search results</p>
                    <ul>
                      <li class="nsx-quick-row is-selected"><span>Redis cache rules</span><em>Architecture</em></li>
                    </ul>
                  </div>
                </div>

                <div class="nsx-stage-diagram">
                  <svg class="nsx-diagram" viewBox="0 96 600 300" preserveAspectRatio="xMidYMid meet" focusable="false">
                    <defs>
                      <marker id="nsx-arrow-hero" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M0 0L10 5L0 10z" fill="#4a5062" />
                      </marker>
                    </defs>
                    <path class="nsx-edge" d="M164 164H226" marker-end="url(#nsx-arrow-hero)" />
                    <path class="nsx-edge" d="M366 164H432" marker-end="url(#nsx-arrow-hero)" />
                    <path class="nsx-edge nsx-edge-dash" d="M296 196V248" marker-end="url(#nsx-arrow-hero)" />
                    <rect class="nsx-shape" x="24" y="132" width="140" height="64" rx="10" />
                    <rect class="nsx-shape" x="226" y="132" width="140" height="64" rx="10" />
                    <rect class="nsx-shape" x="226" y="248" width="140" height="56" rx="10" />
                    <path class="nsx-shape" d="M432 140V196A68 14 0 0 0 568 196V140" />
                    <ellipse class="nsx-shape" cx="500" cy="140" rx="68" ry="14" />
                    <rect class="nsx-sel" x="218" y="124" width="156" height="80" />
                    <rect class="nsx-handle" x="210" y="116" width="8" height="8" rx="1" />
                    <rect class="nsx-handle" x="366" y="116" width="8" height="8" rx="1" />
                    <rect class="nsx-handle" x="210" y="196" width="8" height="8" rx="1" />
                    <rect class="nsx-handle" x="366" y="196" width="8" height="8" rx="1" />
                    <path class="nsx-pen" pathLength="1" d="M32 360C100 326 166 388 236 356" />
                    <text class="nsx-svg-label" x="94" y="170" text-anchor="middle">Browser</text>
                    <text class="nsx-svg-label" x="296" y="170" text-anchor="middle">Go server</text>
                    <text class="nsx-svg-label" x="296" y="282" text-anchor="middle">Redis</text>
                    <text class="nsx-svg-label" x="500" y="178" text-anchor="middle">PostgreSQL</text>
                    <text class="nsx-svg-sub" x="195" y="154" text-anchor="middle">HTTP</text>
                    <text class="nsx-svg-sub" x="399" y="154" text-anchor="middle">SQL</text>
                    <text class="nsx-svg-sub" x="306" y="226">cache</text>
                  </svg>

                  <svg class="nsx-diagram-m" viewBox="0 0 360 340" preserveAspectRatio="xMidYMid meet" focusable="false">
                    <defs>
                      <marker id="nsx-arrow-hero-m" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M0 0L10 5L0 10z" fill="#4a5062" />
                      </marker>
                    </defs>
                    <path class="nsx-edge" d="M180 76V124" marker-end="url(#nsx-arrow-hero-m)" />
                    <path class="nsx-edge" d="M104 180V228" marker-end="url(#nsx-arrow-hero-m)" />
                    <path class="nsx-edge" d="M256 180V228" marker-end="url(#nsx-arrow-hero-m)" />
                    <rect class="nsx-shape" x="24" y="20" width="312" height="56" rx="10" />
                    <rect class="nsx-shape" x="24" y="124" width="312" height="56" rx="10" />
                    <rect class="nsx-shape" x="24" y="228" width="144" height="52" rx="10" />
                    <rect class="nsx-shape" x="192" y="228" width="144" height="52" rx="10" />
                    <path class="nsx-pen" pathLength="1" d="M28 312C90 286 150 330 220 300" />
                    <text class="nsx-svg-label" x="180" y="54" text-anchor="middle">Browser</text>
                    <text class="nsx-svg-label" x="180" y="158" text-anchor="middle">Go server</text>
                    <text class="nsx-svg-label" x="96" y="259" text-anchor="middle">Redis</text>
                    <text class="nsx-svg-label" x="264" y="259" text-anchor="middle">PostgreSQL</text>
                  </svg>
                </div>

                <div class="nsx-codeblock nsx-codewrap">
                  <div class="nsx-codetools">
                    <span class="nsx-lang">JavaScript</span>
                    <span class="nsx-ibtn is-on"><span class="nsx-i" set:html={I.play}></span></span>
                    <span class="nsx-ibtn is-on"><span class="nsx-i" set:html={I.eye}></span></span>
                    <span class="nsx-ibtn"><span class="nsx-i" set:html={I.copy}></span></span>
                    <span class="nsx-ibtn"><span class="nsx-i" set:html={I.more}></span></span>
                  </div>
                  <pre><code><span class="nsx-tk-kw">const</span> cart = [<span class="nsx-tk-num">1200</span>, <span class="nsx-tk-num">3000</span>];
<span class="nsx-tk-kw">const</span> total = cart[<span class="nsx-tk-num">0</span>] + cart[<span class="nsx-tk-num">1</span>];
console.log(<span class="nsx-tk-str">"Total:"</span>, total);</code></pre>
                  <div class="nsx-out">Total: 4200</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CANVAS: shapes, arrows and the component library, runnable code -->
      <section id="canvas" class="nsx-section" aria-labelledby="canvas-title">
        <div class="nsx-wrap">
          <div class="nsx-head">
            <h2 id="canvas-title" class="nsx-h2">Shapes, arrows and free drawing.</h2>
          </div>

          <div class="nsx-board" aria-hidden="true">
            <div class="nsx-rail">
              <span class="nsx-ibtn is-on"><span class="nsx-i" set:html={I.pointer}></span></span>
              <span class="nsx-ibtn"><span class="nsx-i" set:html={I.rect}></span></span>
              <span class="nsx-ibtn"><span class="nsx-i" set:html={I.arrow}></span></span>
              <span class="nsx-ibtn"><span class="nsx-i" set:html={I.pen}></span></span>
              <span class="nsx-ibtn"><span class="nsx-i" set:html={I.image}></span></span>
            </div>

            <svg class="nsx-board-svg" viewBox="0 0 1000 480" preserveAspectRatio="xMidYMid meet" focusable="false">
              <defs>
                <marker id="nsx-arrow-board" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M0 0L10 5L0 10z" fill="#4a5062" />
                </marker>
              </defs>
              <path class="nsx-edge" d="M240 202H350" marker-end="url(#nsx-arrow-board)" />
              <path class="nsx-edge" d="M490 202H640" marker-end="url(#nsx-arrow-board)" />
              <path class="nsx-edge nsx-edge-dash" d="M720 234V300" marker-end="url(#nsx-arrow-board)" />
              <rect class="nsx-shape" x="90" y="170" width="150" height="64" rx="8" />
              <rect class="nsx-shape" x="640" y="170" width="160" height="64" rx="8" />
              <rect class="nsx-shape" x="640" y="300" width="160" height="104" rx="8" />
              <path class="nsx-tint" d="M656 388L690 352L712 372L728 358L784 388Z" />
              <circle class="nsx-shape" cx="760" cy="326" r="8" />
              <path class="nsx-shape is-selected" d="M420 140L490 202L420 264L350 202Z" />
              <path class="nsx-pen" d="M120 380C200 340 260 430 340 396" />
              <path class="nsx-pen" d="M380 420C420 400 470 440 520 414" />
              <rect class="nsx-sel" x="350" y="140" width="140" height="124" />
              <rect class="nsx-handle" x="346" y="136" width="8" height="8" rx="1" />
              <rect class="nsx-handle" x="486" y="136" width="8" height="8" rx="1" />
              <rect class="nsx-handle" x="346" y="260" width="8" height="8" rx="1" />
              <rect class="nsx-handle" x="486" y="260" width="8" height="8" rx="1" />
              <rect class="nsx-toolbar" x="368" y="92" width="104" height="30" rx="8" />
              <g class="nsx-tool-stroke" transform="translate(374 95) scale(0.6)" set:html={paths.stroke}></g>
              <g class="nsx-tool-stroke" transform="translate(398 95) scale(0.6)" set:html={paths.weight}></g>
              <g class="nsx-tool-stroke" transform="translate(422 95) scale(0.6)" set:html={paths.copy}></g>
              <g class="nsx-tool-stroke" transform="translate(446 95) scale(0.6)" set:html={paths.more}></g>
              <text class="nsx-svg-label" x="165" y="207" text-anchor="middle">Request</text>
              <text class="nsx-svg-label" x="420" y="207" text-anchor="middle">Valid?</text>
              <text class="nsx-svg-label" x="720" y="207" text-anchor="middle">Session</text>
              <text class="nsx-svg-sub" x="566" y="194" text-anchor="middle">yes</text>
            </svg>

            <svg class="nsx-board-svg-m" viewBox="0 0 360 560" preserveAspectRatio="xMidYMid meet" focusable="false">
              <defs>
                <marker id="nsx-arrow-board-m" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M0 0L10 5L0 10z" fill="#4a5062" />
                </marker>
              </defs>
              <path class="nsx-edge" d="M180 96V150" marker-end="url(#nsx-arrow-board-m)" />
              <path class="nsx-edge" d="M180 278V330" marker-end="url(#nsx-arrow-board-m)" />
              <path class="nsx-edge nsx-edge-dash" d="M180 386V430" marker-end="url(#nsx-arrow-board-m)" />
              <rect class="nsx-shape" x="40" y="40" width="280" height="56" rx="8" />
              <rect class="nsx-shape" x="40" y="330" width="280" height="56" rx="8" />
              <rect class="nsx-shape" x="40" y="430" width="280" height="100" rx="8" />
              <path class="nsx-shape is-selected" d="M180 150L244 214L180 278L116 214Z" />
              <path class="nsx-tint" d="M60 510L110 466L142 492L162 474L214 510Z" />
              <circle class="nsx-shape" cx="270" cy="462" r="10" />
              <rect class="nsx-sel" x="116" y="150" width="128" height="128" />
              <rect class="nsx-handle" x="112" y="146" width="8" height="8" rx="1" />
