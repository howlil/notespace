# MyPaaS/container runtime listens on all interfaces; the platform manages the host port and public route.
NOTESPACE_BIND_IP=0.0.0.0
NOTESPACE_PORT=8080
# Optional single-owner protection. For remote use, terminate HTTPS at the reverse proxy/platform.
# Username is fixed to `notespace`. Leave empty only on a trusted private network.
NOTESPACE_PASSWORD=
# Keep this value stable across redeploys. Never use `docker compose down -v` for this volume.
NOTESPACE_DATA_VOLUME=notespace-data
