    <script>
      import { latestWindowsInstaller } from '../lib/windows-release.mjs';

      // Progressive enhancement: every download link already points at the verified MSI.
      // If GitHub is unavailable, the static link still works.
      async function refreshWindowsDownload() {
        try {
          const response = await fetch(
            'https://api.github.com/repos/howlil/notespace/releases?per_page=30',
            { headers: { Accept: 'application/vnd.github+json' }, signal: AbortSignal.timeout(3500) },
          );
          if (!response.ok) return;
          const installer = latestWindowsInstaller(await response.json());
          if (!installer) return;
          document.querySelectorAll('a[data-notespace-windows-download]').forEach((link) => {
            link.setAttribute('href', installer.url);
          });
          document.querySelectorAll('[data-notespace-windows-version]').forEach((label) => {
            label.textContent = `v${installer.version}`;
          });
        } catch {
          // Keep the static known-good installer link.
        }
      }
      void refreshWindowsDownload();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Quick Open types a query, swaps the result group, then loops. Static when motion is reduced.
      const quickInput = document.querySelector('[data-quick-input]');
      const quickGroups = [...document.querySelectorAll('[data-results]')];
      const showResults = (key) => quickGroups.forEach((group) => { group.hidden = group.dataset.results !== key; });
      if (quickInput) {
        if (reduceMotion) {
          quickInput.textContent = 'checkout';
          showResults('checkout');
        } else {
          const words = ['checkout', 'postgres', 'redis'];
          let word = 0;
          let count = 0;
          let deleting = false;
          const tick = () => {
            const current = words[word];
            if (!deleting) {
              count += 1;
              quickInput.textContent = current.slice(0, count);
              if (count === current.length) {
                deleting = true;
                showResults(current);
                return setTimeout(tick, 1600);
              }
              return setTimeout(tick, 90);
            }
            count -= 1;
            quickInput.textContent = current.slice(0, count);
            if (count === 0) {
              deleting = false;
              word = (word + 1) % words.length;
              showResults('');
              return setTimeout(tick, 420);
            }
            return setTimeout(tick, 40);
          };
          setTimeout(tick, 1400);
        }
      }

      // Settings theme switch: flips only the Windows window, as the app does.
      const themeWindow = document.querySelector('[data-theme-window]');
      const themeSwitch = document.querySelector('[data-theme-switch]');
      const themeValue = document.querySelector('[data-theme-value]');
      themeSwitch?.addEventListener('click', () => {
        const dark = themeWindow?.dataset.mode !== 'dark';
        if (themeWindow) themeWindow.dataset.mode = dark ? 'dark' : 'light';
        themeSwitch.setAttribute('aria-checked', String(dark));
        if (themeValue) themeValue.textContent = dark ? 'Dark mode' : 'Light mode';
      });

      // Library paging: one page of six at a time, with Previous and Next disabled at the ends.
      const libraryPages = [...document.querySelectorAll('[data-page]')];
      const pagePrev = document.querySelector('[data-page-prev]');
      const pageNext = document.querySelector('[data-page-next]');
      const pageRange = document.querySelector('[data-page-range]');
      let pageIndex = 0;
      const renderPage = () => {
        libraryPages.forEach((page, index) => { page.hidden = index !== pageIndex; });
        const first = pageIndex * 6 + 1;
        if (pageRange) pageRange.textContent = `${first}–${first + 5} of ${libraryPages.length * 6}`;
        if (pagePrev) pagePrev.disabled = pageIndex === 0;
        if (pageNext) pageNext.disabled = pageIndex === libraryPages.length - 1;
      };
      pagePrev?.addEventListener('click', () => { pageIndex = Math.max(0, pageIndex - 1); renderPage(); });
      pageNext?.addEventListener('click', () => { pageIndex = Math.min(libraryPages.length - 1, pageIndex + 1); renderPage(); });
      renderPage();

      // Canvas conflict: the first Use saved Canvas arms the discard confirmation, as the app does.
      const conflictUse = document.querySelector('[data-conflict-use]');
      const conflictKeep = document.querySelector('[data-conflict-keep]');
      const conflictWarning = document.querySelector('[data-conflict-warning]');
      const setConflict = (armed) => {
        if (!conflictUse || !conflictWarning) return;
        conflictWarning.hidden = !armed;
        conflictUse.textContent = armed ? 'Discard local and use saved' : 'Use saved Canvas';
        conflictUse.classList.toggle('is-danger', armed);
        conflictUse.classList.toggle('is-secondary', !armed);
      };
      conflictUse?.addEventListener('click', () => setConflict(conflictWarning.hidden));
      conflictKeep?.addEventListener('click', () => setConflict(false));

      // Code block: the output toggle shows and hides the output; Run shows it too.
      const outputToggle = document.querySelector('[data-toggle="nsx-code-out"]');
      const outputPanel = document.getElementById('nsx-code-out');
      const setOutput = (shown) => {
        if (!outputPanel || !outputToggle) return;
        outputPanel.hidden = !shown;
        const label = shown ? 'Hide code output' : 'Show code output';
        outputToggle.setAttribute('aria-pressed', String(shown));
        outputToggle.setAttribute('aria-label', label);
        outputToggle.title = label;
      };
      outputToggle?.addEventListener('click', () => setOutput(outputPanel?.hidden === true));
      document.querySelector('[data-run]')?.addEventListener('click', () => setOutput(true));

      // Copy buttons swap to a check mark for a moment; the source is copied as shown.
      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const source = document.getElementById(button.dataset.copy ?? '');
          if (!source) return;
          try {
            await navigator.clipboard.writeText(source.textContent ?? '');
            button.dataset.copied = 'true';
            setTimeout(() => { delete button.dataset.copied; }, 1400);
          } catch {
            // Clipboard blocked: the icon does not change.
          }
        });
      });
    </script>
    <script is:inline>
      const menuToggle = document.querySelector('.nsx-menu-toggle');
      const mobileNav = document.getElementById('nsx-mobile-nav');
      function setNav(open) {
        if (!menuToggle || !mobileNav) return;
        mobileNav.dataset.open = String(open);
        menuToggle.setAttribute('aria-expanded', String(open));
      }
      menuToggle?.addEventListener('click', () => setNav(mobileNav?.dataset.open !== 'true'));
      mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setNav(false)));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') setNav(false); });
      document.addEventListener('click', event => {
        if (!menuToggle?.contains(event.target) && !mobileNav?.contains(event.target)) setNav(false);
      });
    </script>
  </div>
</BaseLayout>
