{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "authenticated-loopback-capability",
  "description": "IPC for the Notespace Go sidecar UI loaded on an OS-assigned loopback port. No wildcard hosts, public domains, filesystem or shell permissions.",
  "local": false,
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    },
    "allow-request-desktop-close",
    "allow-allow-desktop-close",
    "allow-cancel-desktop-close",
    "allow-desktop-updater-enabled",
    "allow-prepare-desktop-update",
    "allow-install-prepared-desktop-update",
    "allow-cancel-prepared-desktop-update",
    "allow-list-desktop-recovery-points",
    "allow-desktop-recovery-diagnostics",
    "allow-list-desktop-manual-backups",
    "allow-create-desktop-manual-backup"
  ]
}
