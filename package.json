{
  "name": "notespace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "bun run --filter @notespace/web dev",
    "build": "bun run --filter @notespace/web build && bun install --cwd landing --frozen-lockfile && bun run --cwd landing build",
    "typecheck": "bun run --filter @notespace/web typecheck",
    "lint": "eslint apps/web/src tests scripts/verify/run-node-tests.mjs scripts/verify/browser-*.mjs scripts/verify/ci*.mjs scripts/verify/prepare-native-package-cache.mjs --max-warnings 0",
    "test": "node scripts/verify/run-node-tests.mjs",
    "test:e2e": "bun run --filter @notespace/web build && node scripts/verify/browser-e2e.mjs",
    "test:e2e:critical": "node scripts/verify/browser-e2e.mjs --critical",
    "test:e2e:smoke": "node scripts/verify/browser-e2e.mjs --mode smoke",
    "test:e2e:affected": "node scripts/verify/browser-e2e.mjs --mode affected",
    "test:server:process": "node scripts/verify/server-process-integration.mjs",
    "test:desktop:native": "node scripts/verify/desktop-webdriver-smoke.mjs",
    "test:desktop:critical": "node scripts/verify/desktop-webdriver-smoke.mjs --critical",
    "test:desktop:lifecycle": "node scripts/verify/smoke-desktop-sidecar-lifecycle.mjs",
    "desktop:icons": "node scripts/assets/prepare-desktop-icons.mjs"
  },
  "overrides": {
    "@excalidraw/excalidraw>nanoid": "3.3.18",
    "@excalidraw/mermaid-to-excalidraw>nanoid": "5.1.16",
    "lodash-es": "4.18.1",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@types/node": "24.13.3",
    "lucide-react": "1.41.0",
    "selenium-webdriver": "4.49.0",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6"
  },
  "trustedDependencies": [
    "esbuild",
    "@tailwindcss/oxide"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "selenium-webdriver": "^4.49.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.55.0",
    "webdriverio": "10.1.0"
  }
}
